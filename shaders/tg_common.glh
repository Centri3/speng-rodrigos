{
    vec2  summ = vec2(0.0);
	float ampl = 1.0;
	float gain = pow(noiseLacunarity, -noiseH);
    for (int i=0; i<noiseOctaves; ++i)
    {
        summ  += NoiseVec2(point) * ampl;
		ampl  *= gain;
        point *= noiseLacunarity;
    }
    return summ;
}

