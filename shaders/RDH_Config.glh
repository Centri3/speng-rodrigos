// Configuration for RDH
//Please clear the cache for settings to take effect. Or use the debug menue to reload shaders.
//If you have set "IgnoreShaderBinary      true" in the main_user.cfg you can change the settings in-game using the debug menu.  To access the debug menu hit Shift+8（or * on numpad).  Once in the debug menu you can alter the RDH_Config.glh as desired, hit save and then hit Ctrl+F5 to reload the shaders.


// Gas Giant/Brown Dwarf Color method
const float GasGiantColor = 1;   // 0 is for blended colors, 1 is for harsh colors

// Gas Giant/Brown Dwarf Color Vibrance
const float GasGiantVibe = 0;		// 0 is for vibrant colors, 1 is for muted colors (more realistic)

// Terra Cloud Style  (RDH or Gmail99)
const float CloudStyle = 0;  // 0 is for default RDH clouds, 1 is for Gmail99 clouds

// Europa Crack Leve
const float EuropaCrackLevel = 0;   // 0 is for default, 1 is for extreme levels of cracks (Performance heavy)


// 0.991 Hills Freq Boost
const float SEversion = 1;		//0 is for 0.990, 1 is for 0.991


// *** EXPERIMENTAL / UNFINISHED STUFF ***

//Sp_ce Craters
const float Sp_ce = 0;		// 0 is for default stable craters, 1 is for experimental Sp_ce craters.  Note Sp_ce craters have worse performance than default

//RMR Enceladus-likes
const float RMREnceladus = 0;	// 0 is for default stable Enceladus-likes, 1 is for experimental RMR Enceladus-likes.  Note: These are extremely performance heavy

//New Mountains
const float NewMount = 0;		// 0 is for default stable mountains, 1 is for experimental Mountains (not even close to working)

// New Rifts
const float NewRift = 0;        // 0 is for default stable mountains, 1 is for experimental Rifts

